    "actions": [
      {
        "title": {
          "en": "Set charging mode",
          "de": "Lademodus setzen"
        },
        "titleFormatted": {
          "en": "Set charging mode to [[mode]]",
          "de": "Lademodus auf [[mode]] setzen"
        },
        "hint": {
          "en": "Mode 0 allows simultaneous charging/discharging on V2, but enables PV2 pass-through on V1. The device must confirm the value. MQTT V2 changes are not stored in flash; BLE changes persist and require 60 seconds between setting changes. Schedules and Homey control remain unchanged.",
          "de": "Modus 0 erlaubt bei V2 gleichzeitiges Laden/Entladen, aktiviert bei V1 aber die PV2-Durchleitung. Das Gerät muss den Wert bestätigen. MQTT-V2-Änderungen werden nicht im Flash gespeichert; BLE-Änderungen bleiben gespeichert und benötigen 60 Sekunden Abstand zwischen Einstellungsänderungen. Zeitpläne und Homey-Steuerung bleiben unverändert."
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=b2500|b2500-ble&capabilities=measure_battery"
          },
          {
            "name": "mode",
            "type": "dropdown",
            "title": {
              "en": "Charging mode",
              "de": "Lademodus"
            },
            "values": [
              {
                "id": "0",
                "title": {
                  "en": "Simultaneous charge/discharge (V1: PV2 pass-through)",
                  "de": "Gleichzeitig laden/entladen (V1: PV2-Durchleitung)"
                }
              },
              {
                "id": "1",
                "title": {
                  "en": "Charge first, then discharge",
                  "de": "Erst laden, dann entladen"
                }
              }
            ]
          }
        ],
        "id": "set_charge_mode"
      },
      {
        "title": {
          "en": "Set depth of discharge",
          "de": "Entladetiefe setzen"
        },
        "titleFormatted": {
          "en": "Set depth of discharge to [[percentage]] %",
          "de": "Entladetiefe auf [[percentage]] % setzen"
        },
        "hint": {
          "en": "90 % depth of discharge leaves 10 % battery reserve. The device must confirm the value. MQTT V2 changes are not stored in flash; BLE changes are stored in flash and limited to one change per minute.",
          "de": "90 % Entladetiefe lassen 10 % Batteriereserve. Das Gerät muss den Wert bestätigen. MQTT-V2-Änderungen werden nicht im Flash gespeichert; BLE-Änderungen werden im Flash gespeichert und sind auf eine Änderung pro Minute begrenzt."
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=b2500|b2500-ble&capabilities=measure_battery"
          },
          {
            "name": "percentage",
            "type": "number",
            "title": {
              "en": "Depth of discharge (%)",
              "de": "Entladetiefe (%)"
            },
            "min": 0,
            "max": 100,
            "step": 1
          }
        ],
        "id": "set_dod"
      },
